{
  "name": "deblock-status-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker qui ping les services Deblock Studios et expose leur statut en JSON",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:cron": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "kv:create": "wrangler kv namespace create STATUS_KV"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
